{
  "name": "swipefi.fun",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "concurrently -k \"npm:dev:server\" \"npm:dev:web\"",
    "dev:web": "vite",
    "dev:server": "tsx watch src/server/index.ts",
    "build": "tsc -b && vite build",
    "start": "NODE_ENV=production tsx src/server/index.ts",
    "lint": "biome lint src tests scripts",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest run",
    "test:watch": "vitest",
    "bench:0g": "tsx scripts/bench-0g.ts",
    "verify:0x": "node scripts/verify-0x.mjs",
    "db:migrate": "node scripts/migrate.mjs"
  },
  "dependencies": {
    "@bufbuild/protobuf": "^1.7.2",
    "@connectrpc/connect": "^1.3.0",
    "@connectrpc/connect-node": "^1.3.0",
    "@fontsource/archivo-black": "^5.2.6",
    "@fontsource/dm-sans": "^5.2.6",
    "@fontsource/instrument-serif": "^5.3.0",
    "@privy-io/node": "0.27.0",
    "@privy-io/react-auth": "3.35.2",
    "@solana-program/memo": "^0.8.0",
    "@solana-program/system": "^0.8.0",
    "@solana-program/token": "^0.6.0",
    "@solana/kit": "^5.5.1",
    "@solana/web3.js": "^1.98.4",
    "@substreams/core": "^0.17.0",
    "@types/canvas-confetti": "^1.9.0",
    "@vercel/analytics": "^2.0.1",
    "canvas-confetti": "^1.9.4",
    "dotenv": "^17.4.2",
    "express": "^5.1.0",
    "express-rate-limit": "^8.0.1",
    "helmet": "^8.1.0",
    "lucide-react": "^0.468.0",
    "permissionless": "^0.2.57",
    "pg": "^8.16.3",
    "radix-ui": "^1.6.7",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "viem": "2.55.5",
    "zod": "^4.0.10"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.2.0",
    "@types/express": "^5.0.3",
    "@types/node": "^24.1.0",
    "@types/pg": "^8.15.5",
    "@types/react": "^19.1.9",
    "@types/react-dom": "^19.1.7",
    "@types/supertest": "^6.0.3",
    "@vitejs/plugin-react": "^4.7.0",
    "concurrently": "^9.2.0",
    "supertest": "^7.1.4",
    "tsx": "^4.20.3",
    "typescript": "~5.8.3",
    "vite": "^7.0.6",
    "vitest": "^3.2.4"
  },
  "overrides": {
    "axios": "1.18.1",
    "jayson": {
      "uuid": "8.3.2"
    },
    "rpc-websockets": {
      ".": "9.3.0",
      "uuid": "8.3.2"
    },
    "uuid": "14.0.1",
    "ws": "8.21.1"
  }
}
